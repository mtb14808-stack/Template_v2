local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local LeaderboardServer = require(ServerScriptService.SourceCode.Features.Leaderboard.LeaderboardServer)
local networker = require(ReplicatedStorage.Packages.networker)
local DataManager = require(script.DataManager)
local GamePassManager = require(script.GamePassManager)
local Data = require(ReplicatedStorage.SourceCode.Core.Configs.Data.Data)
local DataTemplate = require(ReplicatedStorage.SourceCode.Core.Configs.Data.DataTemplate)
local TutorialServer = require(ServerScriptService.SourceCode.Features.Tutorial.TutorialServer)
local NetworkSecurity = require(ServerScriptService.SourceCode.Core.ServerUtilities.NetworkSecurity)
local Ragdoll = require(ReplicatedStorage.SourceCode.Core.Utilities.Ragdoll)

local PlayerData = {}
local ActiveObservers = {}
local RagdollCleanupConnection: RBXScriptConnection? = nil

function PlayerData:OnClientReady(player: Player)
	if not player or not player:IsDescendantOf(Players) then
		return
	end
	if NetworkSecurity.CDSecurity(player, "ONCLIENTREADY", 100) then
		return
	end
	local success, err = pcall(function()
		if DataManager.GetTutorialState(player) == false then
			TutorialServer:SendData(player)
		end

		if LeaderboardServer.Inited == true then
			LeaderboardServer:SendDataToPlayer(player)
		end
	end)

	if not success then
		warn("Error sync Init For", player.Name, ":", err)
	end
end

PlayerData.ClientReadyTrigger = networker.server.new("ClientReady", PlayerData, { PlayerData.OnClientReady })

local function _Observe(player: Player, instanceData: { { Instance: ValueBase, DataName: string } })
	task.defer(function()
		if not player:IsDescendantOf(Players) then
			return
		end

		local currentData = Data.server.Service:waitForData(player)
		if not currentData then
			warn("NO DATA FOUND FOR OBSERVING FOR", player.Name)
			return
		end

		for _, settingData in instanceData do
			local valueWrapper = currentData[settingData.DataName]
			if valueWrapper and valueWrapper.Changed then
				local conn = valueWrapper.Changed(function(newValue: number)
					if settingData.Instance and settingData.Instance.Parent then
						settingData.Instance.Value = newValue or 0
					end
				end)

				if ActiveObservers[player.UserId] then
					table.insert(ActiveObservers[player.UserId], conn)
				else
					if typeof(conn) == "function" then
						conn()
					elseif typeof(conn) == "table" and typeof(conn.Disconnect) == "function" then
						conn:Disconnect()
					elseif typeof(conn) == "RBXScriptConnection" then
						conn:Disconnect()
					end
				end
			end
		end
	end)
end

local function Initialize(player: Player, data: DataTemplate.Template)
	if not data.Cash then
		data.Cash = 0
	end

	ActiveObservers[player.UserId] = {}

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local Cash = Instance.new("NumberValue")
	Cash.Name = "Cash"
	Cash.Value = data.Cash or 0
	Cash.Parent = leaderstats

	_Observe(player, {
		{ Instance = Cash, DataName = "Cash" },
	})

	if data.LastLeaveTime and data.LastLeaveTime > 0 then
		local currentTime = os.time()
		local timePassedOffline = currentTime - data.LastLeaveTime
		data.OfflineTime = timePassedOffline
		print("Player " .. player.Name .. " was offline for " .. timePassedOffline .. " seconds.")
	else
		data.OfflineTime = 0
	end

	task.spawn(function()
		if player:IsDescendantOf(Players) then
			pcall(function()
				NetworkSecurity.InitializePlayer(player)
			end)
		end
	end)

	task.spawn(function()
		if player:IsDescendantOf(Players) then
			pcall(function()
				GamePassManager.UpdateOwnerShipData(player)
			end)
		end
	end)
end

function PlayerData.Init()
	if not RagdollCleanupConnection then
		RagdollCleanupConnection = Players.PlayerRemoving:Connect(function(player: Player)
			local character = player.Character
			if character then
				Ragdoll.Stop(character)
			end
		end)
	end

	warn("AGGIUNGERE TIPO RICORMPESE GRUPPO SE SI VUOLE CONE MENU CHE FA VEDERE ESITO COME STEAL AN EGGG ETC")
	warn("CUSTOM PROMPT SCRIPT QUELLO SOLITO ACCERTARSI CHE NON SIA UNCOPYBLOCKE E ILLEGALE")
	warn("RIFARE NOTIFICATAION CON SHADOW DIETRO O CHE STIA CON LO STILE DEL GIOCO")
	function Data.server.Service:onPlayerInit(player: Player, data)
		if player.Parent == Players then
			local ok, err = pcall(function()
				Initialize(player, data)
			end)

			if not ok then
				warn("Initialize error for", player.Name, err)
			end
		end
	end

	Data.server.Service:addPlayerRemovingCallback(function(player: Player, data)
		if ActiveObservers[player.UserId] then
			for _, conn in ActiveObservers[player.UserId] do
				if conn then
					if typeof(conn) == "function" then
						conn()
					elseif typeof(conn) == "table" and typeof(conn.Disconnect) == "function" then
						conn:Disconnect()
					elseif typeof(conn) == "RBXScriptConnection" then
						conn:Disconnect()
					end
				end
			end
			ActiveObservers[player.UserId] = nil
		end

		data.LastLeaveTime = os.time()

		pcall(function()
			NetworkSecurity.RemovePlayer(player)
		end)
	end)
end

return PlayerData
