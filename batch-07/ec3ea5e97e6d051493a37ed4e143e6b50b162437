local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local Frame = require(ReplicatedStorage.SourceCode.Core.Ui.Elements.Frame)
local ScaledFrame = require(ReplicatedStorage.SourceCode.Core.Ui.Elements.ScaledFrame)
local TextLabel = require(ReplicatedStorage.SourceCode.Core.Ui.Elements.TextLabel)
local UIGradient = require(ReplicatedStorage.SourceCode.Core.Ui.Elements.UIGradient)
local UIStroke = require(ReplicatedStorage.SourceCode.Core.Ui.Elements.UIStroke)
local Spring = require(ReplicatedStorage.SourceCode.Core.Ui.Utils.Spring)

export type Source<T> = ((T) -> ()) & (() -> T)

export type NotificationData = {
	Id: string,
	OriginalText: string,
	Type: string,
	Duration: number,
	Text: Source<string>,
	Count: Source<number>,
	ResetTimer: Source<number>,
}

export type Args = {
	Notifications: Source<{ [number]: NotificationData }>,
	AdminNotification: () -> boolean,
}

local springDuration = 0.15
local Direction = "Bottom"
local NotificationSpacing = 98

local Settings = {
	["Error"] = {
		GradientColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 0.352941, 0.352941)),
			ColorSequenceKeypoint.new(1, Color3.new(1, 0.352941, 0.352941)),
		}),
		Sound = "Error",
	},
	["Success"] = {
		GradientColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(0.670588, 1, 0.517647)),
			ColorSequenceKeypoint.new(1, Color3.new(0.015686, 0.866666, 0.156862)),
		}),
		Sound = "Success",
	},
	["Notification"] = {
		GradientColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 0.811764, 0.243137)),
			ColorSequenceKeypoint.new(1, Color3.new(0.980392, 0.792156, 0.043137)),
		}),
		Sound = "Notification",
	},
}

local function GetDataByNotifcationtype(Type: string)
	return Settings[Type]
end

return function(Args: Args)
	return Vide.show(function()
		return #Args.Notifications() > 0
	end, function()
		return ScaledFrame({
			Name = "NotificationsFrame",
			ZIndex = 20,
			Size = UDim2.fromOffset(1000, 90),
			Position = UDim2.fromScale(0.5, 0.2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,


			Vide.values(Args.Notifications, function(data: NotificationData, indexSource: () -> number)
				local dismissed = Vide.source(false)
				local removedFromArray = false
				local timerThread: thread? = nil

				local function startTimer()
					if timerThread then
						task.cancel(timerThread)
					end
					timerThread = task.delay(data.Duration, function()
						dismissed(true)
					end)
				end

				Vide.effect(function()
					local _ = data.ResetTimer()
					startTimer()
				end)

				Vide.effect(function()
					if Args.AdminNotification() == true then
						if timerThread then
							task.cancel(timerThread)
						end
						dismissed(true)
					end
				end)

				Vide.effect(function()
					if dismissed() and not removedFromArray then
						removedFromArray = true
						task.delay(springDuration, function()
							local currentTable = table.clone(Args.Notifications())
							for i, v in ipairs(currentTable) do
								if v.Id == data.Id then
									table.remove(currentTable, i)
									break
								end
							end
							Args.Notifications(currentTable)
						end)
					end
				end)

				Vide.cleanup(function()
					if timerThread then
						task.cancel(timerThread)
					end
				end)

				local SpringScale = Spring.NormalSpring(function()
					return dismissed() == false and 1 or 0
				end, 0, springDuration, 1)

				local SpringY = Spring.NormalSpring(function()
					local currentIndex = indexSource()
					if Direction == "Up" then
						return -((currentIndex - 1) * NotificationSpacing)
					else
						return (currentIndex - 1) * NotificationSpacing
					end
				end, 0, springDuration, 0.7)

				local frame = Frame({
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Position = function()
						return UDim2.fromOffset(500, 35 + SpringY())
					end,

					Frame({
						Vide.create("UIScale")({
							Scale = function()
								return SpringScale()
							end,
						}),
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 0,
						UIGradient({
							Color = ColorSequence.new(Color3.new(0, 0, 0)),
							Transparency = NumberSequence.new({
								NumberSequenceKeypoint.new(0, 1),
								NumberSequenceKeypoint.new(0.21, 0.7),
								NumberSequenceKeypoint.new(0.79, 0.7),
								NumberSequenceKeypoint.new(1, 1),
							}),
						}),
						TextLabel({
							Name = "Notification_" .. data.Id,
							Text = function()
								return data.Text()
							end,
							BackgroundTransparency = 1,
							Size = UDim2.fromScale(0.85, 0.9),
							UseShadow = false,
							UIStroke({ Thickness = 4 }),
							UIGradient({
								Color = GetDataByNotifcationtype(data.Type).GradientColor,
							}),
						}),
					}),
				})

				return frame
			end),
		})
	end)
end
