--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local ScaledFrame = require(script.Parent.ScaledFrame)

local derive = Vide.derive
local spring = Vide.spring

local function IsUDim2Close(a: UDim2, b: UDim2, eps: number?): boolean
	local e = eps or 0.005
	return math.abs(a.X.Scale - b.X.Scale) <= e
		and math.abs(a.X.Offset - b.X.Offset) <= e
		and math.abs(a.Y.Scale - b.Y.Scale) <= e
		and math.abs(a.Y.Offset - b.Y.Offset) <= e
end

export type SlideFrameProps = {
	UseHover: boolean?,
	HoverMult: number?,
	MouseEnterHover: boolean?,
	MouseLeaveHover: boolean?,
	MouseButton1DownHover: boolean?,
	MouseButton1UpHover: boolean?,
	MouseEnter: ((number, number) -> ())?,
	MouseLeave: ((number, number) -> ())?,
	Shown: (() -> boolean)?,
	OnScreenPosition: UDim2?,
	OffScreenPosition: UDim2?,
	Period: number?,
	Damping: number?,
	[any]: any,
}

return function(props: SlideFrameProps)
	local shownFn = if typeof(props.Shown) == "function"
		then props.Shown
		else function()
			return true
		end

	local shownPos = props.OnScreenPosition or UDim2.fromScale(0.5, 0.5)
	local hiddenPos = props.OffScreenPosition or UDim2.fromScale(0.5, 1.5)

	local currentGoal = derive(function()
		return if shownFn() then shownPos else hiddenPos
	end)

	local springPos, setSpring = spring(currentGoal, props.Period or 0.35, props.Damping or 0.8)

	setSpring({ position = hiddenPos })

	local isFinished = derive(function()
		return IsUDim2Close(springPos(), currentGoal())
	end)

	local isVisible = derive(function()
		return shownFn() or not isFinished()
	end)

	local frameProps = {}

	for key, value in props do
		if
			key ~= "Shown"
			and key ~= "OnScreenPosition"
			and key ~= "OffScreenPosition"
			and key ~= "Period"
			and key ~= "Damping"
		then
			frameProps[key] = value
		end
	end

	frameProps.Position = springPos
	frameProps.Visible = isVisible

	return ScaledFrame(frameProps)
end
