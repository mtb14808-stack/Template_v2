test("rifiuta collisioni e init duplicati senza corrompere il JSON precedente", (t) => {
  const { root, put } = fixture(t);
  put("src/SourceCode/Features/Shop/Item.luau");
  assert.equal(writeProject(root), true);
  assert.equal(writeProject(root), false);
  const output = path.join(root, "default.project.json");
  const previous = fs.readFileSync(output, "utf8");
  put("src/SourceCode/Features/Shop/Item.lua");
  assert.throws(() => writeProject(root), /Collisione/);
  assert.equal(fs.readFileSync(output, "utf8"), previous);
  fs.unlinkSync(path.join(root, "src/SourceCode/Features/Shop/Item.lua"));
  put("src/SourceCode/Features/Shop/init.luau");
  put("src/SourceCode/Features/Shop/init.server.luau");
  assert.throws(() => generateProject(root), /Più file init/);
});

async function waitFor(predicate) {
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline) {
    try { if (await predicate()) return; } catch {}
    await new Promise((resolve) => setTimeout(resolve, 25));
  }
  assert.fail("Il watcher non ha aggiornato il mapping in tempo");
}

test("watch: creazione, modifica, rinomina, eliminazione e template", async (t) => {
  const { root, put, template } = fixture(t);
  const errors = [];
  writeProject(root);
  const close = watchProject(root, () => {}, (error) => errors.push(error));
  t.after(close);
  const output = path.join(root, "default.project.json");
  const read = () => JSON.parse(fs.readFileSync(output, "utf8"));
  put("src/SourceCode/Features/New/Nested/TestServer.luau");
  await waitFor(() => read().tree.ServerScriptService.SourceCode.Features.New.Nested.TestServer);
  fs.renameSync(path.join(root, "src/SourceCode/Features/New/Nested/TestServer.luau"), path.join(root, "src/SourceCode/Features/New/Nested/TestClient.luau"));
  await waitFor(() => read().tree.ReplicatedStorage.SourceCode.Features.New.Nested.TestClient);
  assert.equal(read().tree.ServerScriptService.SourceCode.Features, undefined);
  const saved = fs.readFileSync(output, "utf8");
  put("src/SourceCode/Features/New/Nested/TestClient.luau", "return {Changed=true}");
  await new Promise((resolve) => setTimeout(resolve, 350));
  assert.equal(fs.readFileSync(output, "utf8"), saved);
  fs.unlinkSync(path.join(root, "src/SourceCode/Features/New/Nested/TestClient.luau"));
  await waitFor(() => read().tree.ReplicatedStorage.SourceCode.Features.New.Nested.$className === "Folder"
    && !read().tree.ReplicatedStorage.SourceCode.Features.New.Nested.TestClient);
  template.name = "Changed";
  put("rojo.project.template.json", JSON.stringify(template));
  await waitFor(() => read().name === "Changed");
  put("rojo.project.template.json", "{");
  await waitFor(() => errors.length === 1);
  assert.equal(read().name, "Changed");
  put("rojo.project.template.json", JSON.stringify(template));
  put("src/SourceCode/Features/Recovered/RecoveredServer.luau");
  await waitFor(() => read().tree.ServerScriptService.SourceCode.Features.Recovered.RecoveredServer);
});

test("Rojo mantiene la stessa sessione eliminando e ricreando cartelle", async (t) => {
  const rojo = resolveRojo(path.resolve(__dirname, ".."));
  if (spawnSync(rojo, ["--version"], { encoding: "utf8", windowsHide: true }).status !== 0) return t.skip("Rojo non disponibile");
  const { root, put, template } = fixture(t);
  for (const directory of ["Packages", "PlayerData", "ServerPackages"]) fs.mkdirSync(path.join(root, directory));
  put("src/SourceCode/Features/Test/RootClient.luau");
  writeProject(root);
  const port = await new Promise((resolve, reject) => {
    const listener = net.createServer();
    listener.on("error", reject);
    listener.listen(0, "127.0.0.1", () => {
      const chosen = listener.address().port;
      listener.close(() => resolve(chosen));
    });
  });
  template.servePort = port;
  put("rojo.project.template.json", JSON.stringify(template));
  writeProject(root);
  const child = spawn(rojo, ["serve"], { cwd: root, windowsHide: true, stdio: ["ignore", "pipe", "pipe"] });
  const close = watchProject(root, () => {}, () => {});
  let launchError;
  child.on("error", (error) => { launchError = error; });
  let logs = "";
  child.stdout.on("data", (data) => { logs += data; });
  child.stderr.on("data", (data) => { logs += data; });
  const sessions = new Set();
  async function snapshot() {
    if (launchError) throw launchError;
    const base = `http://localhost:${port}`;
    const info = await fetch(`${base}/api/rojo`, { signal: AbortSignal.timeout(750) });
    const content = await info.text();
    const sessionId = content.match(/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/)?.[0];
    assert.ok(sessionId);
    sessions.add(sessionId);
    const rootId = info.headers.get("content-type")?.includes("json")
      ? JSON.parse(content).rootInstanceId : content.match(/[a-f0-9]{32}/)?.[0];
    assert.ok(rootId);
    const response = await fetch(`${base}/api/read/${rootId}`, { signal: AbortSignal.timeout(750) });
    return Buffer.from(await response.arrayBuffer());
  }
  try {
    await waitFor(async () => (await snapshot()).includes(Buffer.from("RootClient")));
    fs.mkdirSync(path.join(root, "tools"));
    fs.copyFileSync(path.join(__dirname, "genRojoTree.js"), path.join(root, "tools/genRojoTree.js"));
    const duplicate = spawnSync(process.execPath, ["tools/genRojoTree.js", "--serve"], {
      cwd: root, encoding: "utf8", windowsHide: true, timeout: 3000,
      env: { ...process.env, ROJO_BIN: rojo },
    });
    assert.equal(duplicate.status, 0, duplicate.stderr);
    assert.equal(duplicate.error, undefined);
    assert.match(duplicate.stdout, /Server già attivo/);
    assert.doesNotMatch(duplicate.stderr, /Rojo crashed/);
    put("src/SourceCode/Features/Test/LiveServer.luau");
    await waitFor(async () => (await snapshot()).includes(Buffer.from("LiveServer")));
    fs.renameSync(path.join(root, "src/SourceCode/Features/Test/LiveServer.luau"), path.join(root, "src/SourceCode/Features/Test/LiveClient.luau"));
    await waitFor(async () => {
      const tree = await snapshot();
      return tree.includes(Buffer.from("LiveClient")) && !tree.includes(Buffer.from("LiveServer"));
    });
    fs.unlinkSync(path.join(root, "src/SourceCode/Features/Test/LiveClient.luau"));
    await waitFor(async () => !(await snapshot()).includes(Buffer.from("LiveClient")));
    put("src/SourceCode/Features/Test/RootClient.luau", 'return {Value="LiveContentChanged"}');
    await waitFor(async () => (await snapshot()).includes(Buffer.from("LiveContentChanged")));
    fs.rmSync(path.join(root, "src/SourceCode/Features/Test"), { recursive: true });
    await waitFor(async () => !(await snapshot()).includes(Buffer.from("RootClient")));
    put("src/SourceCode/Features/Test/RecreatedServer.luau");
    await waitFor(async () => (await snapshot()).includes(Buffer.from("RecreatedServer")));
    fs.mkdirSync(path.join(root, "src/SourceCode/Features/Test/Empty/Nested"), { recursive: true });
    await waitFor(async () => (await snapshot()).includes(Buffer.from("Empty")));
    fs.renameSync(path.join(root, "src/SourceCode/Features/Test/Empty"), path.join(root, "src/SourceCode/Features/Test/EmptyRenamed"));
    await waitFor(async () => (await snapshot()).includes(Buffer.from("EmptyRenamed")));
    put("src/SourceCode/Features/Test/EmptyRenamed/Nested/Temporary.luau");
    await waitFor(async () => (await snapshot()).includes(Buffer.from("Temporary")));
    fs.unlinkSync(path.join(root, "src/SourceCode/Features/Test/EmptyRenamed/Nested/Temporary.luau"));
    await waitFor(async () => {
      const data = await snapshot();
      return !data.includes(Buffer.from("Temporary")) && data.includes(Buffer.from("EmptyRenamed"));
    });
    for (let index = 0; index < 4; index++) {
      put(`src/SourceCode/Features/Test/Nested/Batch${index}/ItemClient.luau`);
      put(`src/SourceCode/Features/Test/Nested/Batch${index}/ItemServer.luau`);
      await waitFor(async () => (await snapshot()).includes(Buffer.from(`Batch${index}`)));
      fs.rmSync(path.join(root, "src/SourceCode/Features/Test"), { recursive: true });
      await waitFor(async () => !(await snapshot()).includes(Buffer.from(`Batch${index}`)));
    }
    assert.equal(child.exitCode, null, logs);
    assert.equal(sessions.size, 1, logs);
    assert.doesNotMatch(logs, /Rojo crashed/);
  } finally {
    close();
    if (child.exitCode === null && !launchError) {
      const exited = new Promise((resolve) => child.once("exit", resolve));
      child.kill();
      await exited;
    }
  }
});

test("watch: elimina una cartella intera e recupera una scansione interrotta", async (t) => {
  const { root, put } = fixture(t);
  put("src/SourceCode/Features/Test/TestComponent.luau");
  put("src/SourceCode/Features/Test/Nested/TestServer.luau");
  writeProject(root);
  const errors = [];
  const close = watchProject(root, () => {}, (error) => errors.push(error));
  t.after(close);
  const original = fs.readdirSync;
  const until = Date.now() + 350;
  fs.readdirSync = function(directory, ...options) {
    if (String(directory).startsWith(path.join(root, "src")) && Date.now() < until) {
      const error = new Error("Directory removed during scan");
      error.code = "ENOENT";
      throw error;
    }
    return original.call(this, directory, ...options);
  };
  try {
    fs.rmSync(path.join(root, "src/SourceCode/Features/Test"), { recursive: true });
    const read = () => JSON.parse(fs.readFileSync(path.join(root, "default.project.json"), "utf8"));
    await waitFor(() => errors.length > 0);
    await waitFor(() => !read().tree.ReplicatedStorage.SourceCode.Features.Test && !read().tree.ServerScriptService.SourceCode.Features);
  } finally {
    fs.readdirSync = original;
  }
  put("src/SourceCode/Features/Test/NewServer.luau");
  await waitFor(() => JSON.parse(fs.readFileSync(path.join(root, "default.project.json"), "utf8")).tree.ServerScriptService.SourceCode.Features.Test.NewServer);
});

test("mappa subito le cartelle vuote sul lato corretto", (t) => {
  const { root } = fixture(t);
  for (const directory of ["Features/Empty/Nested", "Features/EmptyServer/Nested", "Core/ServerUtilities/Empty"]) {
    fs.mkdirSync(path.join(root, "src/SourceCode", directory), { recursive: true });
  }
  const tree = generateProject(root).tree;
  const shared = tree.ReplicatedStorage.SourceCode;
  const server = tree.ServerScriptService.SourceCode;
  assert.equal(shared.Features.Empty.Nested.$className, "Folder");
  assert.equal(shared.Features.Empty.Nested.$path, undefined);
  assert.equal(shared.Features.EmptyServer, undefined);
  assert.equal(server.Features.EmptyServer.Nested.$className, "Folder");
  assert.equal(server.Core.ServerUtilities.Empty.$className, "Folder");
  assert.equal(shared.Core, undefined);
  fs.renameSync(path.join(root, "src/SourceCode/Features/Empty"), path.join(root, "src/SourceCode/Features/Renamed"));
  const renamed = generateProject(root).tree.ReplicatedStorage.SourceCode.Features;
  assert.equal(renamed.Empty, undefined);
  assert.equal(renamed.Renamed.Nested.$className, "Folder");
  fs.rmSync(path.join(root, "src/SourceCode/Features/Renamed"), { recursive: true });
  assert.equal(generateProject(root).tree.ReplicatedStorage.SourceCode.Features, undefined);
});
