local Themes: { [string]: ThemesType } = {
	Green = { ImageId = "rbxassetid://84193398649492", PixelSize = UDim2.fromOffset(230, 100) },
	Robux = { ImageId = "rbxassetid://97626355382355", PixelSize = UDim2.fromOffset(230, 100) },
	None = { ImageId = "", PixelSize = UDim2.fromOffset(230, 100) },
}

local TextProperties = {
	"Text", "TextColor3", "TextSize", "TextScaled", "Font", "FontFace",
	"TextTransparency", "TextStrokeColor3", "TextStrokeTransparency", "TextDirection",
	"TextTruncate", "TextWrapped", "TextXAlignment", "TextYAlignment", "RichText",
	"MaxVisibleGraphemes", "LineHeight", "Thickness", "UseShadow", "ShadowOffset",
	"ShadowColor3", "UseFrameContainer", "Prefix", "PrefixMult", "PrefixPadding",
}

local function read(value: any): any
	return if type(value) == "function" then value() else value
end

return function(props: Props): ImageButton
	local theme = Themes[props.Theme or "Green"]
	assert(theme, "Unknown CustomButton theme: " .. tostring(props.Theme))

	local buttonProps = VideChildrenHandler(props)
	local textProps: { [any]: any } = table.clone(props.TextProps or {})

	for _, name in TextProperties do
		buttonProps[name] = nil
		local value = (props :: any)[name]
		if value ~= nil then textProps[name] = value end
	end

	buttonProps.Name = buttonProps.Name or "CustomButton"
	if buttonProps.Image == nil and buttonProps.ImageContent == nil then
		buttonProps.Image = theme.ImageId
	end
	if buttonProps.Size == nil then
		buttonProps.Size = theme.PixelSize
		if props.SizeMult ~= nil then
			table.insert(buttonProps, Vide.create("UIScale")({
				Name = "ButtonSizeScale",
				Scale = function(): number
					return read(props.SizeMult) or 1
				end,
			}))
		end
	end
	if buttonProps.AutoButtonColor == nil then buttonProps.AutoButtonColor = false end
	buttonProps.UseHover = if props.UseHover ~= nil then props.UseHover else true
	buttonProps.HoverMult = props.HoverMult
	buttonProps.HoverOptions = props.HoverOptions
	buttonProps.MouseEnterHover = props.MouseEnterHover
	buttonProps.MouseLeaveHover = props.MouseLeaveHover
	buttonProps.MouseButton1DownHover = props.MouseButton1DownHover
	buttonProps.MouseButton1UpHover = props.MouseButton1UpHover

	textProps.Name = textProps.Name or "ButtonText"
	textProps.Text = if textProps.Text ~= nil then textProps.Text else "BUTTON"
	textProps.Size = props.TextBoxSize or textProps.Size or UDim2.fromScale(0.85, 0.8)
	textProps.Position = props.TextPosition or textProps.Position or UDim2.fromScale(0.5, 0.5)
	textProps.AnchorPoint = props.TextAnchorPoint or textProps.AnchorPoint or Vector2.new(0.5, 0.5)
	textProps.ZIndex = textProps.ZIndex or function() return (read(props.ZIndex) or 1) + 1 end
	textProps.Thickness = if textProps.Thickness ~= nil then textProps.Thickness else 4
	textProps.BackgroundTransparency = if textProps.BackgroundTransparency ~= nil then textProps.BackgroundTransparency else 1
	textProps.UseHover = false
	textProps.Parent = nil
	if typeof(textProps.Prefix) == "string" then textProps.Prefix = { Image = textProps.Prefix } end

	if props.Children ~= nil then table.insert(buttonProps, props.Children) end
	table.insert(buttonProps, TextLabel(textProps))
	return ImageButton(buttonProps) :: ImageButton
end

