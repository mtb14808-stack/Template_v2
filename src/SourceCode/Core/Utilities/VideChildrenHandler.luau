local function VideChildrenHandler(props: { [any]: any }, target: { [any]: any }?): { [any]: any }
	local result = target or {}

	for key, value in props do
		if target and target[key] ~= nil then
			continue
		end

		if type(key) == "number" then
			table.insert(result, value)
		elseif typeof(key) ~= "string" then
			result[key] = value
		elseif UI_PROPERTIES[key] then
			result[key] = value
		end
	end

	return result
end

return VideChildrenHandler
